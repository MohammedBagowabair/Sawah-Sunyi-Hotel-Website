{
  "name": "sawah-sunyi-hotel-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "deploy": "BASE_PATH=/Sawah-Sunyi-Hotel-Website/ PRELOAD_FONTS=fraunces-latin-wght-normal,manrope-latin npm run build && npx --yes gh-pages -d dist -t -m Deploy"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "lucide-react": "^0.545.0",
    "@fontsource-variable/fraunces": "^5",
    "@fontsource-variable/manrope": "^5",
    "@fontsource-variable/bodoni-moda": "^5",
    "@fontsource-variable/outfit": "^5",
    "@fontsource/cormorant-garamond": "^5",
    "@fontsource-variable/jost": "^5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  }
}